<?xml version="1.0" encoding="utf-8"?>
<Assets>
    <Part Id="KittenBackPackPart">
        <EditorTags>
            <EditorTag Ref="Hidden"/>
        </EditorTags>
        <SubParts>
            <SubPart Key="KittenBackPackSubPart" Ref="KittenBackPackSubPart" />
        </SubParts>
    </Part>

    <SubPart Id="KittenBackPackSubPart">
        <EditorTags>
            <EditorTag Ref="Hidden"/>
        </EditorTags>
    </SubPart>

    <MeshAtlas Id="LightPartMesh" Path="Meshes/circle_light.glb"/>

    <Texture Id="T_LightPack_2_BaseColor" Path="Textures/T_LightPack_2_BaseColor.ktx2" Category="Vessel"/>
    <Texture Id="T_LightPack_2_Normal" Path="Textures/T_LightPack_2_Normal.ktx2" Category="Vessel"/>
    <Texture Id="T_LightPack_2_PBR" Path="Textures/T_LightPack_2_PBR.ktx2" Category="Vessel"/>
    <Texture Id="T_LightPack_2_Emissive_Cold" Path="Textures/T_LightPack_2_Emissive_Cold.ktx2" Category="Vessel"/>
    <PbrMaterial Id="LightPartMaterial">
        <Diffuse Ref="T_LightPack_2_BaseColor"/>
        <Normal Ref="T_LightPack_2_Normal"/>
        <AoRoughMetal Ref="T_LightPack_2_PBR"/>
        <Emissive Ref="T_LightPack_2_Emissive_Cold"/>
    </PbrMaterial>

    <Part Id="LightPart">
        <EditorTags>
            <EditorTag Ref="Lights"/>
            <EditorTag Ref="Hidden"/>
        </EditorTags>
        <SubParts>
            <SubPart Key="LightSubPart" Ref="LightSubPart">
                <Transform>
                    <Scale X="0.3" Y="0.3" Z="0.3"/>
                </Transform>
            </SubPart>
        </SubParts>
    </Part>

    <SubPart Id="LightSubPart">
        <Components>
            <PartModel Key="LightSubPartModel">
                <Mesh Ref="LightPartMesh"/>
                <Material Ref="LightPartMaterial"/>
            </PartModel>

            <MeshView>
                <Mesh Ref="LightPartMesh"/>
            </MeshView>

            <Light Key="PointLight">
                <Type>Point</Type>
                <Transform>
                    <Position X="0" Y="0.1" Z="0"/>
                </Transform>
                <Range Value="2"/>
                <Intensity Value="2"/>
                <Color R="1" G="1" B="1"/>
            </Light>

            <Light Key="SpotLight">
                <Type>Spot</Type>
                <Transform>
                    <Position X="0" Y="0.4" Z="0"/>
                    <Rotation X="0" Y="0" Z="1.5708"/>
                </Transform>
                <Range Value="5"/>
                <Intensity Value="50"/>
                <Color R="1" G="1" B="1"/>
                <InnerAngle Value="0.392599"/>
                <OuterAngle Value="0.785398"/>
            </Light>
        </Components>
    </SubPart>

</Assets>
