    <PartGameData Id="KittenBackPackPart">
        <!-- Without an explicit collider the kitten falls back to the default 2x2x2m bounding-box
             collision shape, which dwarfs the actual kitten and starts intersecting the vehicle it
             EVAs from. Sphere sized to cover the MMU pack (0.211 x 0.274 x 0.483 prism) and the
             RCS nozzles (within ~0.31m of the origin). -->
        <Collider Id="KittenBackPackCollider">
            <Sphere Id="KittenBackPackSphereCollider">
                <LocationAsmb X="0" Y="0" Z="0" />
                <Collider2Asmb X="0" Y="0" Z="0" />
                <Radius M="0.35" />
            </Sphere>
        </Collider>
    </PartGameData>

