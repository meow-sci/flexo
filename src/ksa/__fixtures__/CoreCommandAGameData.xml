            <Grab Key="spine3">
                <Position X="-0.298" Y="0" Z="-0.9339" />
                <Normal X="0.4219" Y="0" Z="-0.9066" />
            </Grab>
            <Grab Key="spine4">
                <Position X="-0.018" Y="0" Z="-0.8046" />
